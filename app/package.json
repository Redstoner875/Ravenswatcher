{
  "name": "ravenswatch-live-readout",
  "version": "0.1.7",
  "private": true,
  "description": "Electron shell hosting the live Ravenswatcher readout page, with the memory reader running on Electron's own Node runtime.",
  "main": "main.js",
  "scripts": {
    "build": "tsc && node scripts/build-icon.js",
    "typecheck": "tsc --noEmit",
    "probe:talents": "npm run build && node reader/bench/talent-rarity-watch.js",
    "edit:talents": "npm run build && node reader/bench/talent-rarity-edit.js",
    "start": "npm run build && electron .",
    "test": "npm run build && node reader/test/run-all.js",
    "dist": "npm run build && node scripts/stage-dist.js && electron-builder --projectDir ../build/stage"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.0.12",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.ravenswatcher.app",
    "productName": "Ravenswatcher",
    "directories": {
      "output": "../build/release"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "asarUnpack": [
      "**/*.node"
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName}-${version}-win-${arch}-Setup.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "Redstoner875",
      "repo": "Ravenswatcher",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-updater": "6.6.2",
    "koffi": "^3.1.6",
    "semver": "7.8.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Redstoner875/Ravenswatcher.git"
  }
}
